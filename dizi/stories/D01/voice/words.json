 "lines": [
  {
   "id": "L01",
   "kim": "ic",
   "start": 0.25,
   "end": 1.682,
   "text": "Gece iki on dört."
  },
  {
   "id": "L02",
   "kim": "ic",
   "start": 1.982,
   "end": 3.591,
   "text": "Nihat'ın telefonu titredi."
  },
  {
   "id": "L03",
   "kim": "ic",
   "start": 3.891,
   "end": 5.516,
   "text": "Ben uyuyormuş gibi yaptım."
  },
  {
   "id": "L04",
   "kim": "ic",
   "start": 6.066,
   "end": 10.421,
   "text": "On iki yıllık evliyiz. Nihat telefonunu hiç yüzüstü koymazdı."
  },
  {
   "id": "L05",
   "kim": "ic",
   "start": 10.771,
   "end": 12.366,
   "text": "Son üç aydır koyuyor."
  },
  {
   "id": "L06",
   "kim": "ic",
   "start": 12.866,
   "end": 17.81,
   "text": "Ekran bir an yandı. Tek bir mesaj: Yarın aynı yerde mi?"
  },
  {
   "id": "L07",
   "kim": "ic",
   "start": 18.26,
   "end": 20.823,
   "text": "Gönderen: Bizim takımdaki Kaan."
  },
  {
   "id": "L08",
   "kim": "ic",
   "start": 21.373,
   "end": 22.896,
   "text": "Nihat futbol oynamaz ki."
  },
  {
   "id": "L09",
   "kim": "nihat",
   "start": 23.596,
   "end": 24.403,
   "text": "Uyumadın mı sen?"
  },
  {
   "id": "L10",
   "kim": "ayca",
   "start": 24.853,
   "end": 26.003,
   "text": "Su içmeye kalktım."
  },
  {
   "id": "L11",
   "kim": "ic",
   "start": 26.603,
   "end": 31.167,
   "text": "Yalan söyledim. Ama bu evde ilk yalanı söyleyen ben değildim."
  },
  {
   "id": "L12",
   "kim": "ic",
   "start": 31.917,
   "end": 36.628,
   "text": "Sabah her zamankinden erken kalktı. Gömleğini iki kez değiştirdi."
  },
  {
   "id": "L13",
   "kim": "nihat",
   "start": 37.078,
   "end": 38.679,
   "text": "Akşam geç kalırım, mesai var."
  },
  {
   "id": "L14",
   "kim": "ic",
   "start": 39.479,
   "end": 41.149,
   "text": "Aynı yer neresiydi, Nihat?"
  }
 ],
 "dur": 41.549
