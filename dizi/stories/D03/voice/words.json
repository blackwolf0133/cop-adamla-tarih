 "lines": [
  {
   "id": "L01",
   "kim": "ic",
   "start": 0.25,
   "end": 3.723,
   "text": "Pazar sabahı. Dünkü gömleği çamaşır sepetindeydi."
  },
  {
   "id": "L02",
   "kim": "ic",
   "start": 4.123,
   "end": 7.474,
   "text": "Maçtan dönen bir adamın gömleği. Ter kokusu yok."
  },
  {
   "id": "L03",
   "kim": "ic",
   "start": 7.924,
   "end": 9.109,
   "text": "Vanilya kokuyordu."
  },
  {
   "id": "L04",
   "kim": "ic",
   "start": 9.559,
   "end": 11.727,
   "text": "Ben vanilya sürmem. Hiç sürmedim."
  },
  {
   "id": "L05",
   "kim": "ic",
   "start": 12.177,
   "end": 15.262,
   "text": "Dünkü aramayı silmiştim. Nihat hiçbir şey anlamadı."
  },
  {
   "id": "L06",
   "kim": "ic",
   "start": 15.662,
   "end": 18.722,
   "text": "Yakasında bir saç teli vardı. Uzun ve sarı."
  },
  {
   "id": "L07",
   "kim": "ic",
   "start": 19.272,
   "end": 20.486,
   "text": "Benim saçım kestane."
  },
  {
   "id": "L08",
   "kim": "ayca",
   "start": 20.986,
   "end": 22.445,
   "text": "Bu saç kimin, Nihat?"
  },
  {
   "id": "L09",
   "kim": "nihat",
   "start": 22.895,
   "end": 26.914,
   "text": "Asansörde biri sürtündü herhalde. Kalabalıktı."
  },
  {
   "id": "L10",
   "kim": "ayca",
   "start": 27.414,
   "end": 29.14,
   "text": "Halı sahanın asansörü mü var?"
  },
  {
   "id": "L11",
   "kim": "nihat",
   "start": 29.64,
   "end": 33.364,
   "text": "Hayatım, bizim apartmanın asansörü. Hadi ama."
  },
  {
   "id": "L12",
   "kim": "ic",
   "start": 33.964,
   "end": 36.789,
   "text": "Gülümsedi. Yalan söylerken hep gülümser."
  },
  {
   "id": "L13",
   "kim": "ic",
   "start": 37.189,
   "end": 39.411,
   "text": "Akşam çöpü çıkarırken merdivende durdum."
  },
  {
   "id": "L14",
   "kim": "ic",
   "start": 39.911,
   "end": 43.32,
   "text": "Aynı koku. Vanilya. Alt kattan geliyordu."
  },
  {
   "id": "L15",
   "kim": "ic",
   "start": 44.12,
   "end": 45.925,
   "text": "Bu apartmanda vanilya kokan kim?"
  }
 ],
 "dur": 46.325
}