 "lines": [
  {
   "id": "L01",
   "kim": "ic",
   "start": 0.25,
   "end": 3.795,
   "text": "Cumartesi akşamı. Nihat halı sahaya gidiyormuş."
  },
  {
   "id": "L02",
   "kim": "ic",
   "start": 4.245,
   "end": 8.084,
   "text": "Çantasını kendisi hazırladı. On iki yılda ilk kez."
  },
  {
   "id": "L03",
   "kim": "nihat",
   "start": 8.584,
   "end": 10.268,
   "text": "Ben bir duş alıp çıkıyorum, hayatım."
  },
  {
   "id": "L04",
   "kim": "ic",
   "start": 10.618,
   "end": 13.72,
   "text": "Su sesi başlar başlamaz çantayı açtım."
  },
  {
   "id": "L05",
   "kim": "ic",
   "start": 14.17,
   "end": 17.574,
   "text": "Kramponlar yepyeni. Etiketi bile üstünde."
  },
  {
   "id": "L06",
   "kim": "ic",
   "start": 18.124,
   "end": 20.945,
   "text": "Kim hiç giymediği ayakkabıyla maça gider?"
  },
  {
   "id": "L07",
   "kim": "ic",
   "start": 21.295,
   "end": 23.112,
   "text": "Telefonu ceketinin cebindeydi."
  },
  {
   "id": "L08",
   "kim": "ic",
   "start": 23.612,
   "end": 27.406,
   "text": "Şifresi hâlâ düğün tarihimiz. Ne incelik."
  },
  {
   "id": "L09",
   "kim": "ic",
   "start": 27.806,
   "end": 31.374,
   "text": "Rehberde tek bir Kaan vardı. Bizim takımdaki Kaan."
  },
  {
   "id": "L10",
   "kim": "ic",
   "start": 31.974,
   "end": 36.247,
   "text": "Aradım. Bir kez çaldı. İki kez çaldı."
  },
  {
   "id": "L11",
   "kim": "kaan",
   "start": 36.847,
   "end": 38.297,
   "text": "Alo? Nihat?"
  },
  {
   "id": "L12",
   "kim": "ic",
   "start": 38.747,
   "end": 39.728,
   "text": "Bir kadın sesi."
  },
  {
   "id": "L13",
   "kim": "ic",
   "start": 40.328,
   "end": 43.44,
   "text": "Tam o an, banyoda su sesi kesildi."
  },
  {
   "id": "L14",
   "kim": "ic",
   "start": 44.24,
   "end": 47.411,
   "text": "Bizim takımdaki Kaan... bir kadın mıydı?"
  }
 ],
 "dur": 47.811
}